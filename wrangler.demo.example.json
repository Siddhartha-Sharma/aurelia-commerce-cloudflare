{
  "name": "aurelia-api-demo",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_PROFILE": "demo",
    "AUTH_ENABLED": "false",
    "DEMO_MODE": "false",
    "DEMO_RESET_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://YOUR-ISOLATED-DEMO-FRONTEND"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aurelia-demo-db",
    "database_id": "REPLACE_WITH_NEW_DEMO_DB_UUID",
    "migrations_dir": "migrations"
  }]
}
