{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aurelia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "DEMO_MODE": "false",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aurelia-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "test": {
      "name": "aurelia-api-test",
      "vars": {
        "DEMO_MODE": "true",
        "ALLOWED_ORIGINS": "https://aurelia-ui-test.pages.dev,https://aurelia-test.pages.dev"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "aurelia-test-db",
        "database_id": "459d54cc-0768-4f5d-92e7-7da71d3d7396",
        "migrations_dir": "migrations"
      }]
    }
  }
}
