{
  "name": "aurelia-api-prod",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_PROFILE": "prod",
    "AUTH_ENABLED": "true",
    "DEMO_MODE": "false",
    "DEMO_RESET_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://YOUR-PRODUCTION-FRONTEND",
    "AUTH_BASE_URL": "https://YOUR-PRODUCTION-FRONTEND",
    "AUTH_SHOP_ID": "aurelia",
    "AUTH_APP_NAME": "Aurelia Jewellery"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aurelia-prod-db",
    "database_id": "REPLACE_WITH_NEW_PRODUCTION_DB_UUID",
    "migrations_dir": "migrations"
  }]
}
